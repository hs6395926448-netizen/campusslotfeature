FLASK_ENV=development

# PostgreSQL (recommended). If DATABASE_URL is set, it is used instead of SQLite.
# Example:
# DATABASE_URL=postgresql+psycopg2://campusslot:strong-password@localhost:5432/campusslot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SECRET_KEY=change-this-secret-key
ADMIN_SECRET_KEY=change-this-admin-secret

# Email API (recommended for cloud). Shared test sender is limited to your Resend account email.
# For real recipients, verify your own domain in Resend and use a sender on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CampusSlot <onboarding@resend.dev>

# Optional Celery background queue. Leave blank for synchronous local development.
# Set to your Redis provider URL on BOTH the web service and worker in production.
CELERY_BROKER_URL=

# SMTP fallback for local development. Use a Gmail App Password, NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
MAIL_FROM=CampusSlot <yourgmail@gmail.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Local development URL. Use your public HTTPS URL in production.
# Must be the URL reachable from the device where you open email.
# Local testing on the same PC: http://127.0.0.1:5000
# Phone/other device on same Wi-Fi: http://YOUR_PC_LAN_IP:5000 (allow port in firewall)
# Deployed app: https://your-real-domain.example
BASE_URL=http://127.0.0.1:5000

APPOINTMENT_TIMEZONE=Asia/Kolkata
